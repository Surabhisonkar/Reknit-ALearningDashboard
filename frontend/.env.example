# Copy to .env.local for local dev (Vite auto-loads .env.local, gitignored by default).
# In production these are build-time values baked in by your CI/CD pipeline -
# never committed, never containing secrets (these are all public client-side values).

VITE_API_BASE_URL=http://localhost:8080

# Cognito Hosted UI - from your User Pool's App Client + domain settings
VITE_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_REDIRECT_URI=http://localhost:5173/
